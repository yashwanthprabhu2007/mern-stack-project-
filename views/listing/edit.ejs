<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2" >

            
            <h1>Enter the details</h1><br>
            <form method="post" action="/listing/<%= list._id%>?_method=PUT" novalidate class="needs-validation"  enctype="multipart/form-data">

                <div class="mb-4">
             
                    <label class="form-label"><b>Title</b></label>
                    <input type="text" name="listing[tittle]" class="form-control" value="<%= list.tittle%>" required>
                    <div class="valid-feedback">Looks good!</div>
                     <div class="invalid-feedback">Please provide a title.</div>


                </div>
                <div class="mb-4">

                    <label class="form-label"><b>Description</b></label>
                    <textarea name="listing[description]" class="form-control" required><%= list.description%></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide a description.</div>
                </div>
                <div class="mb-4">
                    <p>Uploaded file</p>
                   <img src="<%= originalImageUrl %>" alt="">
                </div>
                <div class="mb-4">

                    <label class="form-label"><b>Image URL</b></label>
                    <input type="file" name="listing[image]" value="<%= list.image.url%>" class="form-control" >
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide an image .</div>
                </div>
                <div class="mb-4">

                    <label class="form-label"><b>Price</b></label>
                    <input type="number" name="listing[price]" value="<%= list.price%>" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide a price.</div>
                </div>
                <div class="mb-4">

                    <label class="form-label"><b>location</b></label>
                    <input type="text" name="listing[location]" value="<%= list.location%>" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide a country.</div>
                </div>
                <button class="btn btn-danger border-0">Submit</button>
                
            </form>
        </div>
    </div>

    <script src="/js/bootstrap.js"></script>

</body>
