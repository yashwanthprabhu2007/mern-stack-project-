<% layout("/layouts/boilerplate") %>

<script>
  let maptoken = "<%= process.env.MAP_KEY %>";
  let coordinates = <%- JSON.stringify(list.geometry?.coordinates || [0, 0]) %>;
</script>

<div class="container my-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <!-- ===== Listing Card ===== -->
      <div class="card shadow-sm mb-4 listing-card">
        <img
          src="<%= list.image.url %>"
          class="card-img-top img-fluid"
          alt="Listing Image"
          style="height: 25rem; object-fit: cover"
        />

        <div class="card-body p-4">

          <!-- ===== Listing Info ===== -->
          <h1 class="card-title h2 mb-3"><%= list.title %></h1>
          <p class="text-muted"><%= list.location %> <%= list.country %></p>
          <hr />

          <h5 class="card-title h5 mb-3">
            Owned By <%= list.owner?.username || "Unknown" %>
          </h5>
          <p class="card-text lead"><%= list.description %></p>

          <!-- ===== Action Buttons (Edit / Delete) ===== -->
          <% if (currUser && list.owner && currUser._id.equals(list.owner._id)) { %>
            <div class="d-flex gap-2">
              <a href="/listing/<%= list._id %>/edit" class="btn btn-primary px-4">
                Edit
              </a>

              <form method="post" action="/listing/<%= list._id %>?_method=DELETE">
                <button class="btn btn-danger px-4">Delete</button>
              </form>
            </div>
          <% } %>

          <!-- ===== Leave a Review Form ===== -->
          <div class="mt-4">
            <% if (currUser) { %>
              <h4 class="mb-3">Leave a Review</h4>

              <form
                action="/listing/<%= list._id %>/reviews"
                method="POST"
                class="needs-validation"
                novalidate
              >
                <!-- Rating Input -->
                <fieldset class="starability-grow mb-3">
                  <h5 class="form-label mb-3">Your Rating</h5>

                  <input type="radio" id="rate1" name="review[rating]" value="1" required />
                  <label for="rate1" title="1 star">1 star</label>

                  <input type="radio" id="rate2" name="review[rating]" value="2" />
                  <label for="rate2" title="2 stars">2 stars</label>

                  <input type="radio" id="rate3" name="review[rating]" value="3" />
                  <label for="rate3" title="3 stars">3 stars</label>

                  <input type="radio" id="rate4" name="review[rating]" value="4" />
                  <label for="rate4" title="4 stars">4 stars</label>

                  <input type="radio" id="rate5" name="review[rating]" value="5" />
                  <label for="rate5" title="5 stars">5 stars</label>

                  <span class="starability-focus-ring"></span>
                </fieldset>

                <!-- Comment Input -->
                <div class="mb-3">
                  <label for="comment" class="form-label fw-bold">Comments</label>
                  <textarea
                    name="review[comment]"
                    id="comment"
                    rows="4"
                    class="form-control"
                    placeholder="Share your experience..."
                    required
                  ></textarea>
                  <div class="invalid-feedback">
                    Please add some comments before submitting.
                  </div>
                </div>

                <button type="submit" class="btn btn-outline-dark px-4">
                  Submit
                </button>
              </form>
            <% } %>
          </div>

          <!-- ===== Reviews List ===== -->
          <div class="mt-5">
            <h4 class="fw-semibold mb-4">Reviews</h4>

            <% if (list.reviews.length === 0) { %>
              <p class="text-muted">No reviews yet. Be the first to leave one!</p>
            <% } else { %>
              <div class="row g-3">
                <% for (let review of list.reviews) { %>
                  <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-3">
                      <div class="card-body">

                        <!-- Author name -->
                        <h6 class="card-title fw-bold mb-1">
                          <%= review.author?.username || "Unknown" %>
                        </h6>

                        <!-- Star rating below the name -->
                        <p
                          class="starability-result mb-2"
                          data-rating="<%= review.rating %>"
                          title="<%= review.rating %> out of 5"
                        >
                          Rated: <%= review.rating %> stars
                        </p>

                        <!-- Review comment -->
                        <p class="card-text text-muted small mb-0">
                          <%= review.comment %>
                        </p>

                        <!-- Delete button -->
                        <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                          <form
                            action="/listing/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE"
                            method="POST"
                            class="mt-3"
                          >
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                          </form>
                        <% } %>

                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

          <!-- ===== Map ===== -->
          <div class="mt-4 mb-4">
            <h4 class="fw-semibold mb-3">Where you'll be</h4>
            <div
              id="map"
              class="rounded-3 shadow-sm"
              style="height: 350px; width: 100%;"
            ></div>
          </div>

        </div> <!-- closes card-body -->
      </div> <!-- closes card -->

    </div> <!-- closes col-md-8 -->
  </div> <!-- closes row -->
</div> <!-- closes container my-5 -->

<script src="/js/map.js"></script>