<% layout("/layouts/boilerplate") %>
<body>
   <div class="row">
        <div class="col-8 offset-2" >

            <h1>Create a New Listing</h1><br>
            <form method="post" action="/listing"   novalidate class="needs-validation" enctype="multipart/form-data">  
                


                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" name="listing[tittle]" placeholder="Goa" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide a title.</div>
                </div>




                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="description" class="form-control" required></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide a description.</div>
                </div>


                
                <div class="mb-3">
                    <label class="form-label">Upload Image</label>
                    <input type="file" name="listing[image]" placeholder="" class="form-control" required>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please provide an image.</div>
                </div>


                <div class="row">
                    <div class="col-4">

                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input type="number" name="listing[price]" placeholder="1800" class="form-control" required>
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please provide a price.</div>
                        </div>
                    </div>
                    <div class="col-8">

                        <div class="mb-3">
                            <label class="form-label">Location</label>
                            <input type="text" name="listing[location]" placeholder="India" class="form-control" required>
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please provide a country.</div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                             
                             <div class="mb-3">
                                 <label for="category" class="form-label">Category</label>

<select name="listing[category]" class="form-control" required>
  <option value="" disabled selected>Select a Category</option>
  <option value="Surfing">Surfing</option>
  <option value="Trending">Trending</option>
  <option value="Mountain">Mountain</option>
  <option value="Pool">Amazing Pools</option>
  <option value="Camping">Camping</option>
  <option value="Farm">Farm</option>
  <option value="Arctic">Arctic</option>
</select>                   

                             </div>


                          </div>  
                    </div>  
                </div><br><br>
                <button class="btn btn-danger border-0">Add</button>
                
            </form>
        </div>

   </div>

    
    
     <script src="/js/bootstrap.js"></script>
</body>
